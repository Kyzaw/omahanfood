
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  password String?
  role     Role      @default(USER)
  orders   Order[]   @relation("CustomerOrders")
  deliveries Order[] @relation("CourierOrders")
  reviews  Review[]
}


model Menu {
  id  String @id @default(cuid())
  name  String 
  description String
  categoryId String
  price Int
  image String
  createdAt DateTime @default(now())
  category Category @relation(fields: [categoryId], references: [id])
  reviews Review[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  image String
  menus Menu[]
}

model Order {
  id            String        @id @default(cuid())
  user          User          @relation("CustomerOrders", fields: [userId], references: [id])
  userId        String
  courier       User?         @relation("CourierOrders", fields: [courierId], references: [id])
  courierId     String?
  status        OrderStatus   @default(PENDING)
  deliveryTime  DeliveryTime
  items         Json
  jenisPaket    JenisPaket    @default(HARIAN)
  totalAmount   Int
  address       String
  paymentMethod String
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  reviews       Review[]
}


model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 stars
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  menu      Menu     @relation(fields: [menuId], references: [id])
  menuId    String
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  createdAt DateTime @default(now())
  
  @@unique([orderId, menuId]) // Prevent duplicate reviews for same menu in same order
}

enum Role {
  USER
  ADMIN
  KURIR
}

enum OrderStatus {
  PENDING
  DIBAYAR
  DIMASAK
  SIAP_KIRIM
  DIKIRIM
  SELESAI
}

enum DeliveryTime {
  PAGI
  SIANG
  SORE
}

enum JenisPaket {
  HARIAN
  MINGGUAN
  BULANAN
}
